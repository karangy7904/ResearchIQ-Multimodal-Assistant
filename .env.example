# AWS credentials: prefer an EC2 instance role; do not paste access keys here.
AWS_REGION=ap-south-1
S3_BUCKET=your-researchiq-bucket
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Optional: Bedrock Guardrails. Leave blank to use application-level checks only.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# AutoGen review team currently uses the OpenAI-compatible client.
# Set this key to enable the AutoGen reviewer; this is separate from AWS billing.
OPENAI_API_KEY=
AUTOGEN_MODEL=gpt-4o-mini

# Optional tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ResearchIQ

CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
